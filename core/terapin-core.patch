+bool ScriptMgr::OnEffectDummy(WorldObject* pCaster, uint32 spellId, SpellEffectIndex effIndex, Item* pTarget)
+{
+    // No native C++ script table for item dummies - this exists purely so Lua can act on an
+    // item the player has targeted. Mirrors the Creature and GameObject overloads below.
+#ifdef ENABLE_ELUNA
+    if (Eluna* e = pCaster->GetEluna())
+        e->OnDummyEffect(pCaster, spellId, effIndex, pTarget);
+#endif
+
+    return false;
+}
